# AquaSense AI Production Environment Variables Template

# -----------------------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (Set on Render / Production Server)
# -----------------------------------------------------------------------------

# PostgreSQL database connection string
DATABASE_URL=postgresql://aquasense_user:your_password_here@localhost:5432/aquasense

# Secret key for JWT authentication (generate a 64+ char random string)
JWT_SECRET_KEY=generate_a_secure_random_jwt_secret_key_here

# Allowed origins for CORS (comma-separated list of deployed frontend URLs)
CORS_ORIGINS=https://aquasense-ai.vercel.app,http://localhost:3000,http://localhost:5173

# Optional: OpenWeatherMap API Key (https://openweathermap.org)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Python Runtime Version for Render
PYTHON_VERSION=3.11.10

# -----------------------------------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (Set on Vercel / Netlify)
# -----------------------------------------------------------------------------

# URL of deployed backend FastAPI application
VITE_API_URL=https://aquasense-backend.onrender.com/api

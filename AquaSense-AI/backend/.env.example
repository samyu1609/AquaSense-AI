# Copy this file to .env and fill in real values.

# PostgreSQL connection string. Leave unset to fall back to local SQLite.
DATABASE_URL=postgresql://aquasense:aquasense_pw@localhost:5432/aquasense

# Secret used to sign JWTs — generate a long random string for production.
JWT_SECRET_KEY=change-this-in-production

# Optional: get a free key at https://openweathermap.org/api
# If left blank, the /weather endpoint falls back to a seasonal climatology
# estimate computed from groundwater_master.csv.
OPENWEATHER_API_KEY=

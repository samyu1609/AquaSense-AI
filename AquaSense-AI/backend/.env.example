# AquaSense AI Backend Environment Variables
# Copy this file to backend/.env and replace values for production

# Database configuration (PostgreSQL DSN for production, SQLite default for local dev)
DATABASE_URL=postgresql://aquasense_user:your_password_here@localhost:5432/aquasense

# Security & Authentication
JWT_SECRET_KEY=generate_a_secure_random_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS settings (Comma-separated origins or * for open access)
CORS_ORIGINS=https://aquasense-ai.vercel.app,http://localhost:3000,http://localhost:5173

# Weather API Key (Optional: https://openweathermap.org/api)
# If blank, fallback climatology telemetry is used automatically
OPENWEATHER_API_KEY=your_openweather_api_key_here
